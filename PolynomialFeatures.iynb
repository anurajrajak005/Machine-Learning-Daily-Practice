   "id": "81ed747d-314e-41eb-b318-e05c7e37cac8",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.preprocessing import PolynomialFeatures"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f85bfe60-9c91-462b-8e19-9daaa8f75a8f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset:\n",
      "    Experience  Salary\n",
      "0           1   45000\n",
      "1           2   50000\n",
      "2           3   60000\n",
      "3           4   80000\n",
      "4           5  110000\n",
      "5           6  150000\n",
      "6           7  200000\n"
     ]
    }
   ],
   "source": [
    "# data\n",
    "data = {\n",
    "    \"Experience\": [1,2,3,4,5,6,7],\n",
    "    'Salary': [45000,50000,60000,80000,110000,150000,200000]\n",
    "}\n",
    "df = pd.DataFrame(data)\n",
    "print(\"Dataset:\\n\",df)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "38f85f8e-0b79-4814-8dde-62af8764c7a1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# feature\n",
    "X = df[[\"Experience\"]]\n",
    "y=df[\"Salary\"]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "013b91b3-b0fc-4855-9c87-c1a25db06531",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Transfrom to ploynomial\n",
    "poly = PolynomialFeatures(degree=2)\n",
    "X_poly = poly.fit_transform(X)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
